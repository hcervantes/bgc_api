# --- Server -----------------------------------------------------------
PORT=4000
NODE_ENV=development

# --- Database (API's own Postgres; portal DB is separate by design) ----
DATABASE_URL="postgresql://bgc:bgc@localhost:5433/bgc?schema=public"

# --- JWT verification (RS256; token minted by bgc-portal) -------------
# Public key that pairs with the portal's private signing key.
# PEM with literal \n escapes is fine; the guard normalizes it.
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ISSUER=bgc-portal
JWT_AUDIENCE=bgc-api

# --- Credential sealing (AES-256-GCM key for ErpNextSite secrets) ------
# 32-byte hex: openssl rand -hex 32
ENCRYPTION_KEY=

# --- DigitalOcean Spaces (document storage) ----------------------------
DO_SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
DO_SPACES_REGION=sfo3
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET_DOCS=bgc-tax-documents

# --- Redis (future BullMQ workers) -------------------------------------
REDIS_URL=redis://localhost:6379

# --- Seed values (ids must equal the PORTAL's user ids = JWT sub) ----
SEED_CLIENT_ADMIN_USER_ID=
SEED_CLIENT_ADMIN_EMAIL=clienta-admin@bgcdev.local
# SEED_STAFF_USER_ID=   # uncomment when a real staff user exists in the portal

# ERPNext dev-site API credentials to seal into ErpNextSite
ERPNEXT_SEED_API_KEY=
ERPNEXT_SEED_API_SECRET=
ERPNEXT_SEED_SITE_URL=http://bgc-dev.localhost
ERPNEXT_SEED_API_USER=api@bgcdev.local
