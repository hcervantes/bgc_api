# Dependencies
node_modules/

# Environment & secrets — NEVER commit these
.env
.env.*
!.env.example

# Keys & certificates (RS256 dev keypair, TLS, etc.)
*.key
*.pem
!*.pub

# Build output
dist/
build/
out/

# Logs
logs/
*.log
npm-debug.log*

# Prisma
prisma/*.db
